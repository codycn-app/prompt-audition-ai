# Browser-safe Supabase values only. Never put a service_role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public website URL used in canonical and social-sharing links. Set this in Netlify too.
SITE_URL=https://your-domain.example
